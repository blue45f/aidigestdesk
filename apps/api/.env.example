# @aidigestdesk/api 환경변수 예시 — 실제 값은 .env(gitignore) 또는 배포 플랫폼 env에 설정.

# PostgreSQL(Neon) 연결 문자열. 미설정 시 로컬 JSON 폴백(.data/db.json)으로 동작.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# JWT 서명 비밀키 — 운영은 반드시 강한 랜덤값으로 교체.
JWT_SECRET=change-me-to-a-strong-random-secret

# 서버 포트(기본 4350).
PORT=4350

# 토스 로그인(appLogin) mTLS 인증서 — 앱 승인 후 콘솔에서 발급해 설정(둘 중 한 방식).
# PEM 본문(\n 줄바꿈) 또는 파일 경로. 미설정 시 /auth/toss/login 은 503(익명키 로그인은 정상).
# APPS_IN_TOSS_MTLS_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# APPS_IN_TOSS_MTLS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APPS_IN_TOSS_MTLS_CERT_PATH=/path/to/cert.pem
# APPS_IN_TOSS_MTLS_KEY_PATH=/path/to/key.pem

# 토스 로그인 연결 해제 콜백 Basic Auth. 콘솔 콜백 설정과 동일한 값을 사용.
# 콜백 URL: https://<api-host>/api/auth/toss/unlink (POST)
# APPS_IN_TOSS_UNLINK_USERNAME=aidigestdesk-toss
# APPS_IN_TOSS_UNLINK_PASSWORD=replace-with-a-long-random-password

# 운영자 이메일(쉼표 구분) — 기본 blue45f@gmail.com.
# ADMIN_EMAILS=blue45f@gmail.com
