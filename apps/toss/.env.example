# 즐겨찾기·문의 백엔드(desk-platform 공개 REST) 오리진.
# 코드(src/lib/bookmarks.ts·src/lib/inquiry.ts)가 사용. 미설정 시 기본값 https://desk-platform.vercel.app
VITE_DESK_PLATFORM_URL=https://desk-platform.vercel.app
# 운영 시 desk-platform API CORS 허용 목록에 토스 미니앱 오리진 추가 필요:
#   https://aidigestdesk.apps.tossmini.com         (실서비스)
#   https://aidigestdesk.private-apps.tossmini.com (콘솔 QR 테스트)

# 자체 백엔드(@aidigestdesk/api) 베이스 URL — 회원 계정·프로필 서버 동기화.
# 미설정('')이면 src/lib/auth.ts 가 서버 연동을 건너뛰고 로컬 프로필로만 동작(graceful).
# 배포 후 실 URL 설정(예: https://aidigestdesk-api.vercel.app).
VITE_AIDIGEST_API_URL=

# 콘솔에서 생성한 운영 배너 광고 그룹 ID. 미설정 시 광고를 노출하지 않습니다.
# 출시 번들에는 ait-ad-test-* 테스트 ID를 절대 넣지 마세요(앱인토스 심사 반려 사유).
# 목록·피드 화면과 상세 화면을 분리해 성과와 노출 빈도를 독립적으로 관리합니다.
VITE_TOSS_AD_GROUP_FEED=
VITE_TOSS_AD_GROUP_DETAIL=
